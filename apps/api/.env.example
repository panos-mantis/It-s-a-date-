# Copy to .env and fill in. Never commit .env.

# Runtime environment: development | production | test
NODE_ENV=development

# Port the API listens on. Keep 4000: the web dev proxy expects the API there.
PORT=4000

# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API (0 = none). Set TRUST_PROXY=1 on Render
# so rate limiting and logs see the real client IP.
TRUST_PROXY=0

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# MongoDB Atlas connection string. Must include the database name after the host.
# Production: /ItsADate (only accepted when NODE_ENV=production)   Local development: /itsadate_dev
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/itsadate_dev?retryWrites=true&w=majority

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string

# Max login/register attempts per IP per window (rate limit on auth routes)
AUTH_RATE_LIMIT_MAX=20

# Cloudinary cloud name for image uploads. Phase 7; leave empty until then.
CLOUDINARY_CLOUD_NAME=

# Optional: only if Node can't resolve mongodb+srv on your machine (seen on some Windows setups)
# DNS_SERVERS=8.8.8.8,1.1.1.1
